# syntax=docker/dockerfile:1.4
# parameters
ARG EXERCISE_NAME="lx-reinforcement-learning"
ARG DESCRIPTION="VSCode - Deep reinforcement learning from camera images in the Duckiematrix"
ARG MAINTAINER="Liam Paull (paulll@iro.umontreal.ca)"

# ==================================================>
# ==> Do not change the code below this line
ARG ARCH
ARG DISTRO=ente
ARG DOCKER_REGISTRY=docker.io
ARG BASE_IMAGE=dt-vscode
ARG BASE_TAG=${DISTRO}-${ARCH}
ARG LAUNCHER=default

# define base image
FROM ${DOCKER_REGISTRY}/duckietown/${BASE_IMAGE}:${BASE_TAG} as base

# recall all arguments
ARG DISTRO
ARG EXERCISE_NAME
ARG DESCRIPTION
ARG MAINTAINER
ARG BASE_TAG
ARG BASE_IMAGE
ARG LAUNCHER
# - buildkit
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

# check build arguments
RUN dt-build-env-check "${EXERCISE_NAME}" "${MAINTAINER}" "${DESCRIPTION}"

# define/create repository path
ARG REPO_PATH="${CATKIN_WS_DIR}/src/${EXERCISE_NAME}"
RUN mkdir -p "${REPO_PATH}"
WORKDIR "${REPO_PATH}"

# install apt dependencies
COPY --from=recipe ./dependencies-apt.txt "/tmp/"
RUN dt-apt-install /tmp/dependencies-apt.txt

# install python3 dependencies (the robot-side ones plus what the training notebooks need)
ARG PIP_INDEX_URL="https://pypi.org/simple"
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
COPY --from=recipe ./dependencies-py3.txt ./dependencies-vscode.txt /tmp/
# PyTorch: the PyPI wheels bundle CUDA (several GB), which is only useful on amd64 laptops with an
# NVIDIA GPU (`dts code editor --gpus all`); arm64 editors (e.g., Apple Silicon) get the CPU build
ARG TORCH_CPU_INDEX_URL="https://download.pytorch.org/whl/cpu"
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
        python3 -m pip install torch --index-url "${TORCH_CPU_INDEX_URL}"; \
    fi
RUN python3 -m pip install -r /tmp/dependencies-vscode.txt

# copy the source code (recipe)
# NOTE: `dts code editor` bind-mounts the LX over ${REPO_PATH}, which hides this copy; the
#       recipe packages are therefore also installed in a fixed location that is on PYTHONPATH
#       (the notebooks add the LX's own `packages/` to sys.path themselves).
COPY --from=recipe ./packages "${REPO_PATH}/packages"
COPY --from=recipe ./packages /opt/duckietown/lx-recipe/packages
ENV PYTHONPATH=/opt/duckietown/lx-recipe/packages

# store module metadata
LABEL org.duckietown.label.module.type="exercise-vscode" \
    org.duckietown.label.module.name="${EXERCISE_NAME}" \
    org.duckietown.label.module.description="${DESCRIPTION}" \
    org.duckietown.label.platform.os="${TARGETOS}" \
    org.duckietown.label.platform.architecture="${TARGETARCH}" \
    org.duckietown.label.platform.variant="${TARGETVARIANT}" \
    org.duckietown.label.code.location="ND" \
    org.duckietown.label.code.version.distro="${DISTRO}" \
    org.duckietown.label.base.image="${BASE_IMAGE}" \
    org.duckietown.label.base.tag="${BASE_TAG}" \
    org.duckietown.label.maintainer="${MAINTAINER}"

# <== Do not change the code above this line
# <==================================================

# setup vscode
COPY --from=recipe assets/vscode/setup.sh /tmp/vscode_setup.sh
RUN chmod +x /tmp/vscode_setup.sh && /tmp/vscode_setup.sh